Мёртвый код: цикл ничего не делает, рядом с ним только комментарий
«плитки уже с обработчиками» — обработчики реально вешаются при создании
кнопок-плиток.
---
 0.1.0/windows-setup/system/win11-setup.ps1 | 1 -
 1 file changed, 1 deletion(-)

diff --git a/0.1.0/windows-setup/system/win11-setup.ps1 b/0.1.0/windows-setup/system/win11-setup.ps1
index 23f68ce..4062712 100644
--- a/0.1.0/windows-setup/system/win11-setup.ps1
+++ b/0.1.0/windows-setup/system/win11-setup.ps1
@@ -2045,7 +2045,6 @@ function Update-Preview {
     $prev.Text = "Сейчас произойдёт:`r`n`r`n" + ($steps -join "`r`n")
 }
 
-foreach ($b in $script:tiles) { } # плитки уже с обработчиками
 $chk.Add_CheckedChanged({ Update-Checks; Update-Preview })
 $chkOptimize.Add_CheckedChanged({ Update-Preview })
 $chkClient.Add_CheckedChanged({ Update-Preview })
