В catch-блоке шага «Драйвер видеокарты» переменная $chk использовалась
для состояния видеокарты. Это присваивание на уровне скрипта затирало
одноимённую переменную чекбокса «Со стресс-тестом» из стартового окна
(строка ~1854). Сейчас чекбокс после этого места уже не читается, поэтому
поведение не менялось, но при любом будущем обращении к чекбоксу после
шага драйверов код молча получил бы не тот объект. Переименована в $gpuNow.
---
 0.1.0/windows-setup/system/win11-setup.ps1 | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/0.1.0/windows-setup/system/win11-setup.ps1 b/0.1.0/windows-setup/system/win11-setup.ps1
index 2a2fb1d..23f68ce 100644
--- a/0.1.0/windows-setup/system/win11-setup.ps1
+++ b/0.1.0/windows-setup/system/win11-setup.ps1
@@ -2712,9 +2712,9 @@ if ($DoGpuDriver) {
             }
         } catch {
             # Если, несмотря на ошибку, драйвер по факту стоит (например, поставлен Центром обновления) — это не провал
-            $chk = Get-GpuState | Where-Object { $_.Vendor -eq $job.Vendor } | Select-Object -First 1
-            if ($chk -and $chk.HasDriver) {
-                Report OK "$($chk.Name) — драйвер уже установлен" "версия $($chk.DriverVersion)"
+            $gpuNow = Get-GpuState | Where-Object { $_.Vendor -eq $job.Vendor } | Select-Object -First 1
+            if ($gpuNow -and $gpuNow.HasDriver) {
+                Report OK "$($gpuNow.Name) — драйвер уже установлен" "версия $($gpuNow.DriverVersion)"
                 Write-Log "Драйвер $($job.Vendor): при установке была ошибка ($($_.Exception.Message)), но драйвер на месте"
             } else {
                 Report FAIL "$($gpu.Name) — драйвер не установлен" $_
