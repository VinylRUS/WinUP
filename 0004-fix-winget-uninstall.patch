В Uninstall-WingetApp при сбое запуска процесса $code оставалась $null,
а каст [int]$null даёт 0 — и функция сообщала «удалён», хотя удаление
даже не стартовало. Теперь это отдельная проверка и FAIL.
---
 0.1.0/windows-setup/system/win11-setup.ps1 | 1 +
 1 file changed, 1 insertion(+)

diff --git a/0.1.0/windows-setup/system/win11-setup.ps1 b/0.1.0/windows-setup/system/win11-setup.ps1
index 4062712..59619db 100644
--- a/0.1.0/windows-setup/system/win11-setup.ps1
+++ b/0.1.0/windows-setup/system/win11-setup.ps1
@@ -649,6 +649,7 @@ function Uninstall-WingetApp([string]$Id, [string]$Name) {
         $code = Wait-Task (Start-ProcessTask $Name "$Name — удаляется" $script:WingetExe @(
             'uninstall', '--id', $Id, '-e', '--silent', '--disable-interactivity', '--accept-source-agreements') $out)
     } catch { Write-Log "winget uninstall ${Id}: $($_.Exception.Message)" }
+    if ($null -eq $code) { Report FAIL "$Name — не удалён" 'удаление не запустилось; подробности в логе'; return }
     $code = [int]$code   # без каста форматирование «0x{0:X8}» падает, если код пустой
     Write-Log "winget uninstall $Id -> $code"
     if ($code -eq 0) { Report OK "$Name — удалён" }
