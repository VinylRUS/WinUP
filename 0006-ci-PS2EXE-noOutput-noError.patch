Локальный build-exe.ps1 собирает лаунчеры с -noOutput -noError, а
workflow — без них. В -noConsole-режиме ps2exe эти флаги подавляют
всплывающие окна вывода/ошибок — поведение релизных exe и локальных
сборок становится одинаковым.
---
 .github/workflows/build.yml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 3f1b611..e04e122 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -42,9 +42,9 @@ jobs:
           $sys  = "$root/system"
           $pv   = "${{ steps.ver.outputs.version }}.0"
           Invoke-ps2exe -inputFile "$sys/launcher-setup.ps1"    -outputFile "$root/Настройка Windows.exe" `
-              -iconFile "$sys/icon.ico"    -requireAdmin -noConsole -title 'WinUP'          -company 'DISOTERO' -product 'WinUP' -version $pv
+              -iconFile "$sys/icon.ico"    -requireAdmin -noConsole -noOutput -noError -title 'WinUP'          -company 'DISOTERO' -product 'WinUP' -version $pv
           Invoke-ps2exe -inputFile "$sys/launcher-transfer.ps1" -outputFile "$root/Перенос данных.exe" `
-              -iconFile "$sys/icon-db.ico" -requireAdmin -noConsole -title 'Перенос данных' -company 'DISOTERO' -product 'WinUP' -version $pv
+              -iconFile "$sys/icon-db.ico" -requireAdmin -noConsole -noOutput -noError -title 'Перенос данных' -company 'DISOTERO' -product 'WinUP' -version $pv
           if (-not (Test-Path "$root/Настройка Windows.exe")) { throw "Настройка Windows.exe не собрался" }
           if (-not (Test-Path "$root/Перенос данных.exe"))    { throw "Перенос данных.exe не собрался" }
 
