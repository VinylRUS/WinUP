При $ErrorActionPreference = 'SilentlyContinue' неудачный Start-Process
молча завершал exe: пользователь кликает — и ничего не происходит.
Теперь ошибка показывается в окне (как и отсутствие win11-setup.ps1).
---
 0.1.0/windows-setup/system/launcher-setup.ps1    | 10 +++++++++-
 0.1.0/windows-setup/system/launcher-transfer.ps1 | 10 +++++++++-
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/0.1.0/windows-setup/system/launcher-setup.ps1 b/0.1.0/windows-setup/system/launcher-setup.ps1
index a7748e0..855cafe 100644
--- a/0.1.0/windows-setup/system/launcher-setup.ps1
+++ b/0.1.0/windows-setup/system/launcher-setup.ps1
@@ -22,4 +22,12 @@ if (-not (Test-Path $ps1)) {
 }
 
 # Запускаем настройку. .exe уже с админ-правами (манифест), powershell их наследует.
-Start-Process powershell.exe -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-WindowStyle', 'Hidden', '-File', "`"$ps1`""
+try {
+    Start-Process powershell.exe -ErrorAction Stop -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-WindowStyle', 'Hidden', '-File', "`"$ps1`""
+} catch {
+    Add-Type -AssemblyName System.Windows.Forms
+    [System.Windows.Forms.MessageBox]::Show(
+        "Не удалось запустить:`n$ps1`n`n$($_.Exception.Message)",
+        'Настройка ПК', 'OK', 'Error') | Out-Null
+    exit 1
+}
diff --git a/0.1.0/windows-setup/system/launcher-transfer.ps1 b/0.1.0/windows-setup/system/launcher-transfer.ps1
index e8d146b..b86c237 100644
--- a/0.1.0/windows-setup/system/launcher-transfer.ps1
+++ b/0.1.0/windows-setup/system/launcher-transfer.ps1
@@ -19,4 +19,12 @@ if (-not (Test-Path $ps1)) {
     exit 1
 }
 
-Start-Process powershell.exe -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-WindowStyle', 'Hidden', '-File', "`"$ps1`""
+try {
+    Start-Process powershell.exe -ErrorAction Stop -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-WindowStyle', 'Hidden', '-File', "`"$ps1`""
+} catch {
+    Add-Type -AssemblyName System.Windows.Forms
+    [System.Windows.Forms.MessageBox]::Show(
+        "Не удалось запустить:`n$ps1`n`n$($_.Exception.Message)",
+        'Перенос данных', 'OK', 'Error') | Out-Null
+    exit 1
+}
